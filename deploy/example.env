VAULT_NAME=My Vault
VAULTIST_PORT=8080
# Host path mounted at /vault inside the container (read-write for note edits).
VAULT_HOST_PATH=/srv/Vault
# Optional: UID/GID of the vault directory owner. deploy.sh auto-detects these when unset.
# stat -c '%u %g' /srv/Vault
# VAULT_UID=1000
# VAULT_GID=1000
